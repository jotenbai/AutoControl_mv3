{
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.2",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "140",
  "homepage_url": "https://github.com/jotenbai/AutoControl_mv3",
  "options_ui": {
    "page": "main.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["file42.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "system.display",
    "idle",
    "scripting",
    "alarms",
    "favicon",
    "tabs",
    "offscreen",
    "userScripts",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "bookmarks",
    "sessions",
    "notifications",
    "downloads"
  ],
  "action": {
    "default_icon": {
      "16": "AutoCtrl/logo16.png",
      "24": "AutoCtrl/logo24.png",
      "32": "AutoCtrl/logo32.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "AutoCtrl/logo16.png",
    "48": "AutoCtrl/logo48.png",
    "128": "AutoCtrl/logo128.png"
  },
  "offline_enabled": true,
  "storage": {
    "managed_schema": "AutoCtrl/policySchema.json"
  },
  "web_accessible_resources": [
    {
      "resources": ["AutoCtrl/*", "res/*", "*.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["file23.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self'"
  },
  "key": ""
}
